# REFRACT Configuration
# Copy this file to .env for local development
# Legacy pipeline: at least one critic API key is required.
# Refract v2 uses capability-aware model routing via scripts/refract/providers/registry.py.

GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Legacy critic overrides. Defaults are current as of August 2026.
# GEMINI_CRITIC_MODEL=gemini-3.1-pro-preview
# OPENAI_CRITIC_MODEL=gpt-5.6-sol
# ANTHROPIC_CRITIC_MODEL=claude-sonnet-5

# Legacy Gemini image editing override.
# The retired gemini-3-pro-image-preview endpoint must not be used.
GEMINI_IMAGE_MODEL_POLICY=pro
# GEMINI_IMAGE_MODEL=gemini-3-pro-image
# GEMINI_IMAGE_SIZE=2K
# GEMINI_IMAGE_ASPECT_RATIO=auto
# GEMINI_IMAGE_PASSES=1

# Refract v2 role aliases.
REFRACT_REVIEW_MODEL=gpt-5.6-sol
REFRACT_JUDGE_MODEL=claude-sonnet-5
REFRACT_ARBITER_MODEL=claude-fable-5
REFRACT_IMAGE_MODEL=gpt-image-2-2026-04-21
REFRACT_IMAGE_FALLBACK=gemini-3-pro-image
REFRACT_MASK_PROVIDER=none
REFRACT_PIPELINE_V2=0
